# Copy to .env.local and fill in.
# MongoDB must be a replica set (Atlas is by default; locally run `npm run db`)
MONGODB_URI=mongodb://127.0.0.1:27017/stockpilot?replicaSet=rs0
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Public URL of the app (https in production — camera scanning requires HTTPS)
APP_URL=http://localhost:3000
# Outgoing mail: a Resend API key (re_..., recommended; works on Railway) ...
RESEND_API_KEY=
# ... or SMTP, e.g. smtps://user:pass@smtp.example.com:465 . Unset = links are printed to the server log.
SMTP_URL=
MAIL_FROM=StockPilot <no-reply@example.com>
# Where uploaded product images are stored
UPLOAD_DIR=./uploads
# Optional: separate key for encrypting stored GST API credentials (32+ chars)
ENCRYPTION_KEY=
# Optional: extra hosts allowed for the GST e-invoice API (e.g. your GSP), comma separated
NIC_EXTRA_HOSTS=
